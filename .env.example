# HubSpot
HUBSPOT_ACCESS_TOKEN=your_private_app_token_here
HUBSPOT_PORTAL_ID=your_portal_id_here
HUBSPOT_WEBHOOK_SECRET=your_webhook_secret_here

# Zoho Books
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:8000/zoho/callback
ZOHO_REFRESH_TOKEN=your_initial_refresh_token
ZOHO_ORG_ID=your_zoho_org_id
ZOHO_REGION=com
# Zoho API base: accounts.zoho.{ZOHO_REGION}, books.zoho.{ZOHO_REGION}

# App
DATABASE_URL=sqlite:///./integration.db
SECRET_KEY=change_me_to_random_secret
LOG_LEVEL=INFO
ENVIRONMENT=development

# Closed Won stage ID in HubSpot (get from pipeline settings)
HUBSPOT_CLOSED_WON_STAGE_ID=closedwon

# VAT rate (5% for UAE)
VAT_RATE=0.05

# Rate limiting
ZOHO_RATE_LIMIT_PER_MIN=60
ZOHO_DAILY_LIMIT=2000
